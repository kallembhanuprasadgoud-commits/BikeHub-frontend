{
  "info": {
    "name": "BikeHub - Phase 2 Auth & Users",
    "description": "Postman collection for testing BikeHub Authentication and User Profile endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Register New Buyer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Dravid\",\n  \"email\": \"rahul@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+919876500001\",\n  \"role\": \"BUYER\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "auth", "register"]
            }
          }
        },
